# Copy to .env. The app starts with none of these set; a service without a URL is shown as unavailable.
# EXPO_PUBLIC_ values are compiled into the app: they are public. Never put a secret here.

# ── Swap services (Railway) ─────────────────────────────────────────────────
# cctp-swap-server, one instance per network mode.
EXPO_PUBLIC_SWAP_SERVER_TESTNET=
EXPO_PUBLIC_SWAP_SERVER_MAINNET=
# cashtoken-relayer. One instance serves both; set the second only if mainnet has its own.
EXPO_PUBLIC_CASHTOKEN_RELAYER=
EXPO_PUBLIC_CASHTOKEN_RELAYER_MAINNET=
# Optional price feed (GET /api/v1/prices). Empty: CoinGecko's public API.
EXPO_PUBLIC_PRICE_FEED=

# ── WalletConnect ───────────────────────────────────────────────────────────
# A project id from https://dashboard.reown.com. Without it the Connect screen says so and stays off.
EXPO_PUBLIC_REOWN_PROJECT_ID=

# ── RPC overrides, by network key (optional) ────────────────────────────────
# EXPO_PUBLIC_RPC_BASE=https://...
# EXPO_PUBLIC_RPC_SOLANA=https://...
# Bitcoin uses a Blockbook server; the URL must end in /api.
# EXPO_PUBLIC_RPC_BTC_MAINNET=https://btc1.trezor.io/api
# Bitcoin Cash: comma-separated Fulcrum WebSocket URLs.
# EXPO_PUBLIC_RPC_BCH_MAINNET=wss://bch.imaginary.cash:50004

# ── Build identity (not EXPO_PUBLIC: read by app.config.js at build time) ───
ANDROID_PACKAGE_NAME=
IOS_BUNDLE_IDENTIFIER=
EAS_PROJECT_ID=
