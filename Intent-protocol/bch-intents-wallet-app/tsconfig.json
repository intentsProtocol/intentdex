{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "jsx": "react-native",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@bch-intents/wallet-core": [
        "vendor/wallet-core/src/index.ts"
      ],
      "@bch-intents/wallet-core/*": [
        "vendor/wallet-core/src/*"
      ],
      "@tetherto/wdk-react-native-core/src/*": [
        "node_modules/@tetherto/wdk-react-native-core/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor/wdk-wallet-bch"
  ]
}
