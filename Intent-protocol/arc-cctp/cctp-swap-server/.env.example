# cctp-swap-server — local dev only. In production set these as sealed platform secrets (see src/secrets.ts).
# `npm run gen:keys` fills in any missing keys below and prints the addresses to fund.

PORT=3012
# CCTP_NETWORK=testnet           # or mainnet: real USDC. Run it as a second instance on its own PORT.
#                                # Before the first mainnet start: CCTP_NETWORK=mainnet npm run verify:chains
DATA_DIR=./data                  # leave unset on mainnet (default ./data-mainnet); the two networks never share one
LOG_LEVEL=info
# ENABLED_CHAINS=eth-sepolia,op-sepolia,arb-sepolia,base-sepolia,arc-testnet,solana-devnet   # default: all
# IRIS_BASE_URL=https://iris-api-sandbox.circle.com

# ── Relayer (pays destination gas; never holds user funds) ─────────────────────
CCTP_RELAYER_EVM_KEY=            # 0x… one address on every EVM chain (Arc gas = USDC)
CCTP_RELAYER_SOLANA_KEY=         # JSON byte array or base58 secret key
ADMIN_API_KEY=                   # x-admin-key for /admin/*; admin routes are disabled when empty

# ── RPCs (public defaults are used when unset; use a provider for anything beyond testing) ──
# ETH_SEPOLIA_RPC=
# OPTIMISM_SEPOLIA_RPC=
# ARBITRUM_SEPOLIA_RPC=
# BASE_SEPOLIA_RPC=
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Mainnet (CCTP_NETWORK=mainnet). The public defaults are rate limited: use a provider before taking traffic.
# ETHEREUM_RPC=
# OPTIMISM_RPC=
# ARBITRUM_RPC=
# BASE_RPC=
# ARC_RPC=https://rpc.mainnet.arc.io
# SOLANA_MAINNET_RPC=            # also used by the Solana swaps below

# ── Limits / tuning ───────────────────────────────────────────────────────────
# MIN_TRANSFER_USDC=1
# MAX_TRANSFER_USDC=100
# CREATED_TTL_MIN=60
# BURN_NOT_FOUND_MIN=30
# FEE_BUFFER_PCT=20
# STANDARD_FAST_ENOUGH_SEC=60
# POLL_INTERVAL_MS=3000
# EVM_MINT_WAIT_TIMEOUT_MS=90000

# ── Solana same-chain swaps through Jupiter (mainnet only; see ../jupdocs) ──────────────
JUPITER_API_KEY=                 # developers.jup.ag/portal; without it the keyless limit applies (0.5 req/s)
# JUPITER_ENABLED=true
# JUPITER_RPS=                   # default 0.5 without a key, 1 with one; raise to match a paid plan
# JUPITER_REFERRAL_ACCOUNT=      # our fee on Solana swaps; can also be created or set from /admin/swap/profits
# JUPITER_REFERRAL_FEE_BPS=      # 50-255; the admin settings override it. A fee turns off Jupiter's gasless swaps.
# JUPITER_MAX_SLIPPAGE_BPS=1000
# JUPITER_ORDER_TTL_SEC=120
# JUPITER_SWEEP_INTERVAL_MS=30000  # how often unsigned swaps are expired and lost execute replies settled
# SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com

# ── E2E test user (scripts/e2e_*.ts, tests/long/*) — a separate wallet, never the relayer ──
E2E_EVM_KEY=
E2E_SOLANA_KEY=
# RELAYER_URL=http://localhost:3012

# ── Lending (/lend/*, through Liquidium) ──
# Mainnet only: the protocol has no testnet. The server holds no keys for this; users send their own collateral.
LEND_ENABLED=false
LEND_POLL_SEC=45                 # how often open loans are refreshed
