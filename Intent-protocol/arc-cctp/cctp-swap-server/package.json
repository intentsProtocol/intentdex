{
  "name": "cctp-swap-server",
  "version": "0.1.0",
  "description": "USDC chain A -> USDC chain B via Circle CCTP V2 (quote, build tx, track burn, relay mint)",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "gen:keys": "tsx scripts/gen_keys.ts",
    "check:balances": "tsx scripts/balances.ts",
    "verify:chains": "tsx scripts/verify_chains.ts",
    "e2e": "tsx scripts/e2e_transfer.ts",
    "test:unit": "tsx tests/run-all.ts --only=unit",
    "test:short": "tsx tests/run-all.ts --only=short",
    "test:all": "tsx tests/run-all.ts",
    "test:all:long": "tsx tests/run-all.ts --long"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@coral-xyz/anchor": "^0.31.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^8.1.1",
    "@jup-ag/referral-sdk": "^0.3.0",
    "@liquidium/client": "0.10.0",
    "@paryonusd/contracts": "1.1.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "cashscript": "0.13.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20.16.0",
    "chalk": "^5.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
