{
    "name": "cashtoken-relayer",
    "version": "1.0.0",
    "description": "Relayer for BCH Dutch Auction and Limit Order Swaps",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "start": "npx tsx src/index.ts",
        "build": "tsc",
        "test:limit": "npx tsx test/e2e_limit_order.ts",
        "test:dutch": "npx tsx test/e2e_dutch_auction.ts",
        "test:relayer": "npx tsx test/e2e_relayer_bot.ts",
        "test:router": "npx tsx test/e2e_cauldron_router.ts",
        "test:router:skip-live": "SKIP_LIVE_POOL_TEST=1 npx tsx test/e2e_cauldron_router.ts",
        "test:token-fills": "npx tsx test/e2e_token_fills.ts",
        "test:spread": "npx tsx test/e2e_spread_capture.ts",
        "test:multi": "npx tsx test/e2e_multi_direction.ts",
        "test:quant": "npx tsx test/quant_sanity.ts",
        "test:policy": "npx tsx test/policy_sanity.ts",
        "test:scheduler": "npx tsx test/scheduler_sanity.ts",
        "inventory:report": "npx tsx scripts/redust_inventory.ts",
        "inventory:redust": "npx tsx scripts/redust_inventory.ts --apply",
        "test:ledger": "npx tsx test/ledger_sanity.ts",
        "test:clock": "npx tsx test/clock_sanity.ts",
        "test:dust": "npx tsx test/dust_sanity.ts",
        "test:collision": "npx tsx test/collision_sanity.ts",
        "test:whitelist": "npx tsx test/whitelist_sanity.ts",
        "test:lifecycle": "npx tsx test/lifecycle_sanity.ts",
        "test:lifecycle-e2e": "npx tsx test/e2e_lifecycle_multi.ts",
        "test:bch-token": "npx tsx test/e2e_bch_to_token.ts",
        "test:matrix": "npx tsx test/e2e_full_matrix.ts",
        "test:stress": "npx tsx test/stress_fill_throughput.ts",
        "bench:latency": "npx tsx test/bench_fill_latency.ts",
        "test:pusd-egg": "npx tsx test/e2e_pusd_egg_chipnet.ts",
        "test:generic": "npx tsx test/e2e_generic_token.ts",
        "test:router-validate": "npx tsx test/router_chipnet_validation.ts",
        "test:live-fill": "npx tsx test/e2e_live_fill_test5.ts",
        "test:direct": "npx tsx test/e2e_direct_liquidity.ts",
        "test:direct-only": "npx tsx test/e2e_direct_only.ts",
        "test:multiple-direct": "npx tsx test/e2e_multiple_direct.ts",
        "test:unfilled": "npx tsx test/e2e_unfilled_orders.ts",
        "test:live-solver": "npx tsx test/live_solver_chipnet.ts",
        "test:inventory": "npx tsx test/e2e_multi_token_inventory.ts",
        "test:inventory:skip-live": "SKIP_LIVE=1 npx tsx test/e2e_multi_token_inventory.ts",
        "test:concurrency": "npx tsx test/concurrency_sanity.ts",
        "test:cancel-early": "npx tsx test/e2e_cancel_early.ts",
        "test:concurrent-orders": "npx tsx test/e2e_concurrent_orders.ts",
        "test:profit-tracking": "npx tsx test/e2e_profit_tracking.ts"
    },
    "dependencies": {
        "@cashlab/cauldron": "^1.0.2",
        "@cashlab/common": "^1.0.5",
        "@fastify/cors": "^11.2.0",
        "@fastify/swagger": "^9.7.0",
        "@fastify/swagger-ui": "^5.2.5",
        "@fastify/websocket": "^11.2.0",
        "cashscript": "^0.12.1",
        "dotenv": "^16.4.5",
        "fastify": "^5.7.4",
        "mainnet-js": "^3.1.7",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@types/node": "^20.12.7",
        "@types/ws": "^8.18.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.7.0",
        "typescript": "^5.4.5"
    }
}
