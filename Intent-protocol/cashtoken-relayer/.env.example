NETWORK=chipnet
PORT=3006

# Option A: Supply Key directly (Preferred for container/Railway)
RELAYER_PRIVATE_KEY_WIF=
# Option B: Use wallet path (Local Dev)
WALLET_PATH=../contracts-bch-swap/wallet.json
# Optional second wallet to also run a live mainnet solver instance (leave
# unset to run mainnet in read-only/quote-only mode).
MAINNET_PRIVATE_KEY_WIF=

WATCH_ADDRESSES=
SLEEP_MS=10000

# How many matched intents the bot fills concurrently per scan cycle. Each
# fill can involve up to 3 sequential on-chain steps with mempool waits, so
# at 1 (fully serial) many simultaneous orders back up badly. UTXO-selection
# safety across concurrent fills is enforced by src/bot/UtxoReservation.ts
# regardless of this value. Raising it trades a little ProfitLedger
# predicted-vs-realized measurement precision for much lower per-order
# latency under load.
SOLVER_CONCURRENCY=4

# ── Lifecycle & discovery tuning ──────────────────────────────────────────
# Seconds a fully-decayed Dutch auction stays fillable at floor price before
# the bot triggers the permissionless cancel() refund (the maker's only exit —
# Dutch deliberately has no cancelEarly()).
DUTCH_FLOOR_GRACE_SEC=1800
# Seconds a created-but-never-funded intent stays watched before being marked
# 'abandoned' and dropped from the scan set.
FUNDING_DEADLINE_SEC=3600
# Concurrent Electrum queries during the address sweep (serial = minutes at
# 50+ watched addresses; 8 measured ~30x faster).
SCAN_CONCURRENCY=8
# Base for exponential retry backoff on 'failed' (but still funded) intents, ms.
FAIL_BACKOFF_BASE_MS=60000

# ── Profit Policy ─────────────────────────────────────────────────────────
# A quote is only executed if it passes ALL THREE thresholds. See
# docs/profit.md for the full explanation and per-token override file format.
PROFIT_MIN_SATS=1500
PROFIT_MIN_BPS=30
MAX_SLIPPAGE_BPS=500
# Optional: path to a JSON file with per-token profit overrides (see docs/profit.md)
PROFIT_POLICY_FILE=

# Optional separate address that receives the predicted-profit slice on every
# fill (profit segregation). If unset, profit stays in the operating wallet.
RELAYER_PROFIT_ADDRESS=

# ── Token whitelist ─────────────────────────────────────────────────────────
# Which tokens the solver will fill intents for. Resolution order, PER NETWORK:
#   1. TOKEN_CONFIG_FILE_{MAINNET,CHIPNET}      JSON { allow?, deny?, perToken? }
#   2. FILL_TOKEN_WHITELIST_{MAINNET,CHIPNET}   comma-separated category hex
#   3. FILL_TOKEN_WHITELIST                     DEPRECATED, network-blind
#   4. (default) derived from live Cauldron pools with TVL >= MIN_POOL_TVL_SATS
#
# Leaving all of these unset is the RECOMMENDED setup: the whitelist derives
# itself from live pool depth, stays current, and degrades safely (no pool means
# no route means nothing to whitelist). An explicit list has to be maintained by
# hand and rots — a category with no pool can sit "whitelisted" forever while
# being permanently unfillable.
#
# WARNING: FILL_TOKEN_WHITELIST is network-BLIND — one list gates BOTH mainnet
# and chipnet. Populated with chipnet categories, a mainnet relayer matches
# nothing and fills ZERO orders. It still works but warns on load; prefer the
# per-network file, which also scopes correctly and carries perToken overrides.
FILL_TOKEN_WHITELIST=
FILL_TOKEN_WHITELIST_MAINNET=
FILL_TOKEN_WHITELIST_CHIPNET=
TOKEN_CONFIG_FILE_MAINNET=
TOKEN_CONFIG_FILE_CHIPNET=

# Minimum Cauldron pool TVL (sats) for a token to be auto-whitelisted. Filters
# out pools too shallow to fill without ruinous slippage. Default 1000000 (0.01 BCH).
MIN_POOL_TVL_SATS=1000000

# Minimum BCH sats a token UTXO must carry for a DIRECT (inventory) fill.
# The covenant enforces exactly 2 inputs, so the fill fee comes out of the token
# UTXO's own dust. Authoritative for BOTH the router's viability check AND the
# executor's token-change floor — they must agree or inventory starves itself.
MIN_TOKEN_UTXO_DUST_SATS=3500

# INVENTORY_TOKEN_IDS: tokens the solver may spend as 2-hop trade supply
#   (INVENTORY_TO_TOKEN routing). If unset, defaults to whatever it holds.
INVENTORY_TOKEN_IDS=
